# Copy this file to ".env" (same folder as docker-compose.yml) and
# adjust for your host. docker compose loads .env automatically.

# Info used for meta-site gallery hosted in reverse proxy (see proxygallery repo)
SITE_TITLE="Photo Site"
SITE_DESCRIPTION="Website of photographer"
# URL of the site's preview picture: drop the file into PUBLIC_DIR (below)
# and it is served at the site root, e.g. PUBLIC_DIR/thumbnail.jpg ->
SITE_THUMBNAIL=https://photo.laurentml.fr/thumbnail.jpg

# Port exposed on the host machine.
HOST_PORT=3000

# Host paths backing the five external volumes. The defaults below
# (relative to this compose file) are fine for trying things out; for a
# real deployment, point these at real, persistent paths on the host
# server, e.g.:
#   CONFIG_DIR=/srv/photographer-site/config
#   CONTENT_DIR=/srv/photographer-site/content
#   GALLERIES_DIR=/srv/photographer-site/galleries
#   PHOTOS_DIR=/srv/photographer-site/photos
#   PUBLIC_DIR=/srv/photographer-site/public
# Each directory is created empty on first run if it doesn't exist yet,
# and the container seeds it with sample content/images the first time
# it finds it empty - after that, only what you put there is used.
CONFIG_DIR=./data/config
CONTENT_DIR=./data/content
GALLERIES_DIR=./data/galleries
PHOTOS_DIR=./data/photos
# Public files served at the site root (thumbnail.jpg for proxygallery, ...)
PUBLIC_DIR=./data/public

# UID/GID the app runs as inside the container. Set these to match the
# host user that owns the directories above (run `id -u` / `id -g` on
# the host) so files stay editable from outside Docker too.
PUID=1000
PGID=1000

# Optional. Leave unset to auto-generate a random CAPTCHA signing secret
# on every container start (fine for a single instance - it only
# invalidates any contact-form challenge that was mid-flight across a
# restart, which self-heals since a new one is issued on the next page
# load). Set this explicitly only if you run more than one replica
# behind a load balancer and need them to accept each other's tokens.
# CAPTCHA_SECRET=

# Optional. Secret signing the "Your Photos" (private gallery) access
# cookies. Leave unset to auto-generate one on every start - customers
# then just have to type their password again after a restart.
# GALLERY_ACCESS_SECRET=

# Proof-of-work difficulty (leading zero bits) for the contact-page
# CAPTCHA. Higher = slower/more CPU-expensive to solve per submission.
CAPTCHA_POW_BITS=18
