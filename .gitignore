# Dependencies / logs
node_modules/
npm-debug.log*

# Local secrets & per-host settings (copy .env.example to .env)
.env

# Live site data (./data/*, also the default docker-compose volumes).
# This is the deployed copy of sample/ that gets edited on the server,
# so it must never be committed. Only the empty directory skeleton
# (.gitkeep) is kept in git. The sample data itself lives in sample/.
/data/**
!/data/*/
!/data/*/.gitkeep

# Archives / OS / editor clutter
*.zip
.DS_Store
Thumbs.db
