  </main>

  <!-- Shared lightbox overlay: used by every gallery component on the page -->
  <div id="lightbox" class="lightbox" hidden>
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <figure class="lightbox-figure">
      <img class="lightbox-image" src="" alt="" />
      <figcaption class="lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="lightbox-nav lightbox-next" aria-label="Next photo">&#8250;</button>
  </div>

  <footer class="site-footer">
    <p>&copy; <%= new Date().getFullYear() %> <%= siteConfig.footer.copyrightName || siteConfig.site.title %>. All rights reserved.</p>
    <div class="socials">
      <% (siteConfig.footer.socials || []).forEach(function(s) { %>
        <a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.label %></a>
      <% }); %>
    </div>
  </footer>
  <script src="/public/js/gallery.js"></script>
</body>
</html>
