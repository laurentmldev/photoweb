<%- include('partials/layout-top') %>

<section class="page-intro">
  <div class="page-intro-header">
    <h1><%= page.title %></h1>
    <a class="button" href="/your-photos">Your Photos</a>
  </div>
  <% if (page.intro) { %><p><%= page.intro %></p><% } %>
</section>

<section class="gallery-list">
  <% galleries.forEach(function(g) { %>
    <a class="gallery-card" href="/galleries/<%= g.slug %>">
      <div class="gallery-card-thumb">
        <% if (g.images.length > 0) { %>
          <img src="<%= g.images[0].src %>" alt="<%= g.images[0].alt %>" loading="lazy" />
        <% } else { %>
          <div class="gallery-card-thumb-empty"></div>
        <% } %>
      </div>
      <h2 class="gallery-card-title"><%= g.title %></h2>
      <p class="gallery-card-description"><%= g.description %></p>
    </a>
  <% }); %>
</section>

<%- include('partials/layout-bottom') %>
