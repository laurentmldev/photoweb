<%- include('partials/layout-top') %>

<section class="page-intro">
  <h1><%= page.title %></h1>
  <% if (page.intro) { %><p><%= page.intro %></p><% } %>
</section>

<% if (!verified) { %>
  <section class="human-check">
    <p class="human-check-label">Please confirm you're human to view contact details.</p>
    <% if (error) { %><p class="human-check-error"><%= error %></p><% } %>
    <form
      class="human-check-form"
      method="POST"
      action="/contact/verify"
      data-pow-token="<%= challenge.token %>"
      data-pow-difficulty="<%= challenge.difficulty %>"
    >
      <%- include('partials/human-check-question', { challenge: challenge }) %>
      <div class="human-check-row">
        <input type="text" inputmode="numeric" pattern="[0-9]*" id="captcha-answer" name="answer" required autocomplete="off" />
        <button type="submit" disabled>Show contact details</button>
      </div>
      <p class="pow-status" role="status">Preparing verification…</p>
    </form>
  </section>
<% } else { %>
  <section class="contact-details">
    <ul>
      <% if (page.email) { %><li><strong>Email:</strong> <a href="mailto:<%= page.email %>"><%= page.email %></a></li><% } %>
      <% if (page.phone) { %><li><strong>Phone:</strong> <%= page.phone %></li><% } %>
      <% if (page.location) { %><li><strong>Location:</strong> <%= page.location %></li><% } %>
    </ul>
    <div class="contact-socials">
      <% (page.socials || []).forEach(function(s) { %>
        <a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.label %></a>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (!verified) { %>
  <script src="/public/js/captcha-pow.js"></script>
<% } %>

<%- include('partials/layout-bottom') %>
